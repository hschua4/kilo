# Copy to /srv/kilo/.env on the VPS, then: chmod 600 .env && chown deploy:deploy .env
# Consumed by the `kilo` and `migrate` services in docker-compose.yml.

# Postgres — "postgres" is the service name on the shared docker network.
# Use the per-app role created by /srv/infra/postgres/bootstrap.sh (KILO_DB_PW).
DATABASE_URL=postgresql://kilo:REPLACE_WITH_KILO_DB_PW@postgres:5432/kilo?schema=public

# Better Auth — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM
BETTER_AUTH_URL=https://kilo.hschua.com

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Add this Authorized redirect URI:
#   https://kilo.hschua.com/api/auth/callback/google
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME

# AI insights via OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=REPLACE_ME
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

NODE_ENV=production
PORT=3000
