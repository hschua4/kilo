# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/scaleiq?schema=public"

# Better Auth — generate a secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI insights via OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Any OpenRouter model id, e.g. anthropic/claude-3.5-haiku, openai/gpt-4o-mini
OPENROUTER_MODEL="anthropic/claude-3.5-haiku"
